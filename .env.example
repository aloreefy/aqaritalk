# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# When using Docker Compose this is pre-configured. Change only if using an
# external Postgres instance.
DATABASE_URL=postgresql://aqaritalk:aqaritalk_dev@localhost:5432/aqaritalk

# ── AI ────────────────────────────────────────────────────────────────────────
# Google AI Studio key. Get a free key at https://aistudio.google.com
# Use an AIza... prefix key (not AQ...) for the 1,500 req/day free tier
# on gemini-2.0-flash.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here

# ── LangGraph broker (Python sidecar) ────────────────────────────────────────
# URL the Node API uses to reach the Python broker (langgraph-broker/server.py).
# - Node in Docker, broker on the host:  http://host.docker.internal:8000
# - Everything on the host (no Docker):   http://localhost:8000
# - Shared broker on another machine:     http://<that-machine>:8000
AGENT_URL=http://host.docker.internal:8000

# The broker's LLM runs on OpenAI (ChatOpenAI / gpt-4o-mini). Set OPENAI_API_KEY
# and DATABASE_URL in langgraph-broker/.env — broker_graph.py loads that file via
# python-dotenv. See langgraph-broker/.env.example.

# ── Property seeder (seed/seed.py) ───────────────────────────────────────────
# Optional local GGUF model the seeder uses to write Arabic descriptions (~3GB,
# NOT in the repo). Not needed if you seed with --no-llm (template descriptions).
GEMMA_PATH=C:\path\to\gemma-4-E2B-it-Q4_K_M.gguf
