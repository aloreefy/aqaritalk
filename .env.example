# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# When using Docker Compose this is pre-configured. Change only if using an
# external Postgres instance.
DATABASE_URL=postgresql://aqaritalk:aqaritalk_dev@localhost:5432/aqaritalk

# ── AI ────────────────────────────────────────────────────────────────────────
# Google AI Studio key. Get a free key at https://aistudio.google.com
# Use an AIza... prefix key (not AQ...) for the 1,500 req/day free tier
# on gemini-2.0-flash.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing secret. Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here

# ── Broker agent sidecar ────────────────────────────────────────────────────
# URL the Node API uses to reach the Python agent (agent/server.py).
# - Node in Docker, agent on the host:  http://host.docker.internal:8000
# - Everything on the host (no Docker):  http://localhost:8000
# - Shared agent on another machine:     http://<that-machine>:8000
# Only the machine that actually runs the agent needs the model below; others
# can point AGENT_URL at it and skip the GGUF entirely.
AGENT_URL=http://host.docker.internal:8000

# Absolute path to the local GGUF model the agent loads (~3GB, NOT in the repo —
# obtain it separately). Read by agent/server.py and agent/agent.py. The default
# baked into the code is one developer's machine path, so set this to your own.
# NOTE: the Python agent reads real environment variables and does NOT load this
# .env file — export MODEL_PATH in the shell before running the agent.
MODEL_PATH=C:\path\to\gemma-4-E2B-it-Q4_K_M.gguf

# Same model, used by the property seeder (seed/seed.py). Usually identical to
# MODEL_PATH. Not needed if you only seed with --no-llm (template descriptions).
GEMMA_PATH=C:\path\to\gemma-4-E2B-it-Q4_K_M.gguf
