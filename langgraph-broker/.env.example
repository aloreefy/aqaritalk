# Copy this file to .env in this folder and fill in your values.
# broker_graph.py loads this .env via python-dotenv on startup.
# Never commit .env.

# OpenAI API key — the broker's LLM runs on ChatOpenAI (gpt-4o-mini).
OPENAI_API_KEY=sk-...

# Postgres the broker reads/writes property data from. Matches docker-compose.
DATABASE_URL=postgresql://aqaritalk:aqaritalk_dev@localhost:5432/aqaritalk

# Customer-service contact card shown by the get_contact_info tool.
SUPPORT_PHONE=+962-6-XXX-XXXX
SUPPORT_EMAIL=support@aqaritalk.com
SUPPORT_WHATSAPP=+962-7X-XXX-XXXX
SUPPORT_HOURS=السبت–الخميس 9:00–18:00
