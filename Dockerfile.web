# Debian/glibc base (not alpine/musl): pnpm-workspace.yaml keeps only the
# `-gnu` native binaries (e.g. @rollup/rollup-linux-x64-gnu) and strips the
# musl ones, so Vite/rollup can't load on alpine. glibc matches the kept set.
FROM node:24-slim AS base

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json tsconfig.json ./

COPY lib/ ./lib/
COPY artifacts/web/ ./artifacts/web/

RUN pnpm install --frozen-lockfile

WORKDIR /app/artifacts/web

ENV PORT=5173
ENV BASE_PATH=/

EXPOSE 5173

CMD ["pnpm", "run", "dev"]
